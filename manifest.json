
{
  "manifest_version": 3,
  "name": "UnscrewIt!",
  "version": "0.0",
  "action":{
  	"default_title": "UnscrewIt!",
  	"default_popup": "popup/main.html"
  },
  "description": "Applies physics to elements present in any webpage.",

 "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["./dist/content.js"],
      "world": "MAIN"
    }],


"permissions": 
	["scripting","activeTab","storage"],
"browser_specific_settings": {
    "gecko": {
        "id": "thrasher@cool.org",
        "strict_min_version": "109.0"
    }
}


}
